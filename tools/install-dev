#!/usr/bin/env python3
"""Install or atomically update a development package without host approvals."""
import argparse
import ctypes
import json
import os
from pathlib import Path
import shutil
import tempfile
import time

parser = argparse.ArgumentParser()
parser.add_argument('package', type=Path)
parser.add_argument('plugins', type=Path)
parser.add_argument('--replace', action='store_true')
args = parser.parse_args()
manifest = json.loads((args.package / 'manifest.json').read_text())
if manifest['id'] != 'io.github.shinnycharizard.apple-music' or not (args.package / 'plugin').is_file():
    raise SystemExit('This is not an Apple Music development package')
args.plugins.mkdir(parents=True, exist_ok=True)
target = args.plugins / manifest['id']
if target.is_symlink():
    raise SystemExit('Refusing to replace a symlink')
if target.exists() and not args.replace:
    raise SystemExit('Already installed; use --replace to preserve a backup and atomically update')
with tempfile.TemporaryDirectory(prefix='.install-apple-', dir=args.plugins) as temporary:
    staged = Path(temporary) / manifest['id']
    shutil.copytree(args.package, staged)
    if target.exists():
        previous = json.loads((target / 'manifest.json').read_text())
        if previous.get('id') != manifest['id']:
            raise SystemExit('Existing package identity does not match')
        # An active bwrap bind keeps the previous directory inode and libraries.
        # Swap complete directories; never rewrite a running mapped executable.
        libc = ctypes.CDLL(None, use_errno=True)
        exchange = libc.renameat2
        exchange.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        exchange.restype = ctypes.c_int
        backups = args.plugins / '.backups'
        backups.mkdir(exist_ok=True)
        backup = backups / f"{manifest['id']}-{previous['version']}-{time.time_ns()}"
        if exchange(-100, os.fsencode(staged), -100, os.fsencode(target), 2):
            raise OSError(ctypes.get_errno(), 'Atomic package exchange failed')
        staged.rename(backup)
        print('Previous package: ' + str(backup))
    else:
        staged.rename(target)
print(target)
print('Restart this plugin in Plugin to load the new package; account data and approvals are unchanged.')
