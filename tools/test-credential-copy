#!/usr/bin/env python3
"""Exercise the production credential-copy block with a copying ABI fixture."""
from pathlib import Path
import subprocess
import sys
import tempfile

native = Path(sys.argv[1]) / 'drm/native'
source = (native/'main.c').read_text()
block = source.split('    union std_string password = new_std_string(amPassword);', 1)[1]
block = '    union std_string password = new_std_string(amPassword);' + block.split('    _ZN17storeservicescore19CredentialsResponse15setResponseType', 1)[0]
# Use the SDK's actual borrowed-string representation and constructor.
header = (native/'import.h').read_text().split('struct shared_ptr {', 1)[1]
header = 'struct shared_ptr {' + header.split('extern void curl_easy_setopt', 1)[0]
setter = '_ZN17storeservicescore19CredentialsResponse11setPasswordERKNSt6__ndk112basic_stringIcNS1_11char_traitsIcEENS1_9allocatorIcEEEE'
fixture = '''
#include <stdint.h>
#include <stddef.h>
#include <string.h>
#include <assert.h>
''' + header + '''
static char copied[520];
static void SETTER(void *obj, union std_string *s) {
    (void)obj;
    assert(s->size < sizeof(copied));
    memcpy(copied, s->data, s->size);
    copied[s->size] = 0;
}
static void exercise(const char *base, const char *code) {
    char storage[520];
    strcpy(storage, base);
    int passLen = strlen(storage);
    strcat(storage, code);
    char *amPassword = storage;
    struct shared_ptr credResp = {0};
    BLOCK
    assert(strlen(copied) == strlen(base) + strlen(code));
    assert(memcmp(copied, base, strlen(base)) == 0);
    assert(strcmp(copied + strlen(base), code) == 0);
    assert(strcmp(amPassword, base) == 0);
}
int main(void) {
    exercise("fixture-password", "123456");
    exercise("fixture-password", "654321");
    exercise("fixture-password", "");
    char long_password[513];
    memset(long_password, 'x', 512); long_password[512] = 0;
    exercise(long_password, "123456");
    return 0;
}
'''.replace('SETTER', setter).replace('BLOCK', block)
with tempfile.TemporaryDirectory(prefix='plugin-credential-copy-') as tmp:
    c = Path(tmp)/'test.c'
    exe = Path(tmp)/'test'
    c.write_text(fixture)
    subprocess.run(['cc', '-std=gnu11', '-Wall', '-Wextra', '-Werror', str(c), '-o', str(exe)], check=True)
    subprocess.run([str(exe)], check=True)
print('PASS: production credential-copy block preserves the complete 2FA reply before restoring the password')
