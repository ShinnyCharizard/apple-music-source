{
  "id": "io.github.shinnycharizard.apple-music",
  "name": "Apple Music (Lossless)",
  "version": "1.1.3",
  "api_version": 1,
  "kind": "source",
  "runtime": "process",
  "description": "Apple Music with separate web browsing and native lossless playback sessions. A numbered setup assistant connects both accounts. Linux x86_64; subscription required. Playback components download only when requested.",
  "icon": "icon.svg",
  "folder_icon": "folder.svg",
  "author": "ShinnyCharizard",
  "capabilities": [
    {
      "type": "network",
      "domains": [
        "music.apple.com",
        "amp-api.music.apple.com",
        "play.itunes.apple.com",
        "sf-api-token-service.itunes.apple.com",
        "itunes.apple.com",
        "mzstatic.com",
        "universal-activity-service.itunes.apple.com",
        "raw.githubusercontent.com",
        "authorize.music.apple.com"
      ]
    },
    {
      "type": "register_source"
    },
    {
      "type": "register_panel"
    },
    {
      "type": "own_account",
      "keyring": false
    }
  ]
}
