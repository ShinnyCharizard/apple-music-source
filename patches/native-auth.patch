+/* Forward the wrapper callbacks registered by the Go coordinator. */
+void drm_forward_auth(const char *type, char *buf, int size, void *ud)
+{
+    (void)ud;
+    if (size > 0) memset(buf, 0, (size_t)size);
+    call_auth_callback(type, buf, size);
+}
+
+void drm_forward_state(const char *state, void *ud)
+{
+    (void)ud;
+    call_state_callback(state);
+}
