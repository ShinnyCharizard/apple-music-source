-        free(tmp_path);
-        free(path);
-        return -1;
-    }
-
-    int result = fprintf(f, "%s", content) > 0 ? 0 : -1;
-    fclose(f);
-
-    if (result == 0) {
-        result = (rename(tmp_path, path) == 0) ? 0 : -1;
-    }
-    if (result != 0) {
-        unlink(tmp_path);
-    }
-
-    free(tmp_path);
-    free(path);
-    return result;
-}
-
-static char *load_token(const char *filename)
-{
-    if (!filename) {
-        return NULL;
-    }
-    
-    char *path = get_mpl_db_path(filename);
-    if (!path) {
-        return NULL;
-    }
-    
-    FILE *f = fopen(path, "r");
-    free(path);
-    
-    if (!f) {
-        return NULL;
-    }
-    
-    fseek(f, 0, SEEK_END);
-    long size = ftell(f);
-    fseek(f, 0, SEEK_SET);
-    
-    if (size <= 0 || size > 65536) {
-        fclose(f);
-        return NULL;
-    }
-    
-    char *content = malloc(size + 1);
-    if (!content) {
-        fclose(f);
-        return NULL;
-    }
-    
-    size_t read_size = fread(content, 1, size, f);
-    content[read_size] = '\0';
-    fclose(f);
-    
-    return content;
-}
